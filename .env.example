# Copy to .env (scripts/acc.py setup does this for you). .env is git-ignored. NEVER commit real keys.
# Real environment variables override values in this file.

# demo = offline mock agents, no keys, no cost.  live = real providers (needs the keys below).
ACC_MODE=demo

# --- Provider credentials (API keys from each provider's developer console) -------------------
# A ChatGPT / Claude / Perplexity SUBSCRIPTION does not include API access; API usage is billed separately.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# --- Models (verify these ids against each provider's current model list before live use) ------
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_MODEL=claude-opus-5-5
# cheaper alternative for Claude: claude-sonnet-5-5
ANTHROPIC_EFFORT=medium
# Perplexity Agent API preset (e.g. low) or an explicit model id in PERPLEXITY_MODEL (overrides the preset)
PERPLEXITY_PRESET=low
PERPLEXITY_MODEL=

# --- Free local model via Ollama (https://ollama.com): no key, no per-use cost ------------------
# Install Ollama, run `ollama pull llama3.1:8b`, then set the model name here and ACC_MODE=live.
LOCAL_MODEL=
# Ollama CLOUD instead (prompts are sent to Ollama's servers): sign in with `ollama signin`, run
# `ollama run gemma4:cloud` once, then LOCAL_MODEL=gemma4:cloud. For direct API calls also set:
# LOCAL_BASE_URL=https://ollama.com  and  OLLAMA_API_KEY=...  (use a model name from the cloud list, e.g. gemma4:31b)
OLLAMA_API_KEY=
# LOCAL_BASE_URL=http://127.0.0.1:11434
# LOCAL_NUM_CTX=16384

# --- Server (loopback only by default) ----------------------------------------------------------
ACC_HOST=127.0.0.1
ACC_PORT=8787
# ACC_DATA_DIR=./data
# ACC_ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
